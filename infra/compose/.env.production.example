# Copy this file to the repository root as .env.production. Do not commit it.
POSTGRES_USER=askyourdata
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=askyourdata
JWT_SECRET=replace-with-a-long-random-jwt-secret
FERNET_KEY=replace-with-a-valid-fernet-key
INTERNAL_ADMIN_TOKEN=replace-with-a-long-random-internal-token
CORS_ALLOW_ORIGINS=https://analytics.example.com
FRONTEND_PORT=80

# Configure the LLM provider used by the semantic router and SQL generator.
DEEPSEEK_API_KEY=replace-with-provider-key
