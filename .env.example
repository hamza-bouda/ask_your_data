# ==============================================================================
# ASK YOUR DATA — Development Environment Configuration (.env.example)
# Copy this file to .env and adjust variables as necessary for development.
# ==============================================================================

# --- LLM Provider Configuration ---
# Choose LLM provider: deepseek, openai, or mock (offline development)
LLM_PROVIDER=deepseek
# DeepSeek API credentials
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1

# --- Security & Encryption Keys ---
# 32-byte URL-safe base64-encoded Fernet key for encrypting tenant DB credentials at rest
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# JWT Secrets for Authentication and Token Signing
JWT_SECRET=dev-secret-change-in-production
JWT_SECRET_KEY=dev-secret-change-in-production
INTERNAL_ADMIN_TOKEN=dev-internal-admin-token

# --- Microservices URLs (Docker Compose Network) ---
IDENTITY_URL=http://identity:8001
CATALOG_URL=http://catalog:8002
SQL_EXECUTOR_URL=http://sql-executor:8007
ORCHESTRATOR_URL=http://orchestrator:8004
SEMANTIC_ROUTER_URL=http://semantic-router:8008
SQL_GENERATOR_URL=http://sql-generator:8006
VISUALIZATION_URL=http://visualization:8005
GATEWAY_URL=http://localhost:8000

# --- Core Platform Database & Caching ---
DATABASE_URL=postgresql+psycopg2://askyourdata:askyourdata_dev@postgres:5432/askyourdata
POSTGRES_USER=askyourdata
POSTGRES_PASSWORD=askyourdata_dev
POSTGRES_DB=askyourdata

REDIS_URL=redis://redis:6379/0

# --- Tracing & Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=ask_your_data
PROMETHEUS_METRICS_ENABLED=true

# --- Application Environment ---
APP_ENV=development
LOG_LEVEL=INFO
