# ==============================================================================
# ASK YOUR DATA — Production Environment Configuration (.env.production.example)
# Mandatory configuration for secure, production-grade deployments.
# IMPORTANT: All placeholder values MUST be replaced with secure secrets.
# ==============================================================================

# --- LLM Provider Configuration ---
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-prod-your-real-deepseek-key-here
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1

# --- Security & Cryptography (MANDATORY UNIQUE SECRETS) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=MUST_BE_GENERATED_32_BYTE_BASE64_KEY

# Secure high-entropy JWT secrets (minimum 64 characters recommended)
# Generate with: openssl rand -base64 48
JWT_SECRET=MUST_BE_SECURE_RANDOM_SECRET_KEY
JWT_SECRET_KEY=MUST_BE_SECURE_RANDOM_SECRET_KEY
INTERNAL_ADMIN_TOKEN=MUST_BE_SECURE_INTERNAL_TOKEN

# --- Microservices Endpoints ---
IDENTITY_URL=http://identity:8001
CATALOG_URL=http://catalog:8002
SQL_EXECUTOR_URL=http://sql-executor:8007
ORCHESTRATOR_URL=http://orchestrator:8004
SEMANTIC_ROUTER_URL=http://semantic-router:8008
SQL_GENERATOR_URL=http://sql-generator:8006
VISUALIZATION_URL=http://visualization:8005
GATEWAY_URL=https://api.yourdomain.com

# --- Core Platform Database & Caching ---
DATABASE_URL=postgresql+psycopg2://askyourdata_app:STRONG_PASSWORD_HERE@postgres:5432/askyourdata_prod
POSTGRES_USER=askyourdata_app
POSTGRES_PASSWORD=STRONG_PASSWORD_HERE
POSTGRES_DB=askyourdata_prod

REDIS_URL=redis://:REDIS_AUTH_PASSWORD@redis:6379/0

# --- Tracing, Metrics & Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=ask_your_data_prod
PROMETHEUS_METRICS_ENABLED=true

# --- Runtime & Logging ---
APP_ENV=production
LOG_LEVEL=WARNING
