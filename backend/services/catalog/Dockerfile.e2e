FROM python:3.12-slim

WORKDIR /app

COPY packages/contracts /tmp/contracts
COPY packages/observability /tmp/observability
RUN pip install --no-cache-dir /tmp/contracts /tmp/observability && rm -rf /tmp/contracts /tmp/observability

COPY backend/services/catalog/requirements.e2e.txt .
RUN pip install --no-cache-dir -r requirements.e2e.txt

COPY backend/services/catalog/app ./app

EXPOSE 8002
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8002"]
